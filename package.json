{
  "name": "@dailyshot/issue-automation-action",
  "version": "0.1.0",
  "private": true,
  "description": "Dailyshot shared GitHub issue automation action.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
